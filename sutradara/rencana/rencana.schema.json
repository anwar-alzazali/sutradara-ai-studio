{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anwar-alzazali/sutradara-ai-studio/rencana.schema.json",
  "title": "Rencana sutradara (resep bagian G)",
  "description": "Keputusan tingkat video (visual inti, preset suasana, peran, hook, dalil) + daftar beat yang masing-masing berisi shot. Struktur dicek skema ini; aturan keselamatan dicek sutradara/rencana/penjaga.py.",
  "type": "object",
  "required": [
    "judul",
    "visual_inti",
    "peran",
    "hook",
    "dalil",
    "beat"
  ],
  "additionalProperties": false,
  "properties": {
    "judul": {
      "type": "string",
      "minLength": 3
    },
    "catatan": {
      "type": "string"
    },
    "visual_inti": {
      "type": "object",
      "required": [
        "benda",
        "jalur_keadaan"
      ],
      "additionalProperties": false,
      "properties": {
        "benda": {
          "type": "string"
        },
        "jalur_keadaan": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        }
      }
    },
    "peran": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nama",
          "kategori",
          "tampil"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "nama": {
            "type": "string"
          },
          "kategori": {
            "enum": [
              "nabi",
              "malaikat",
              "sahabat",
              "manusia",
              "makhluk_ghaib",
              "dajjal",
              "yajuj_majuj",
              "hewan"
            ]
          },
          "wujud_dalil": {
            "type": "boolean",
            "description": "true bila wujud fisiknya dijelaskan dalil sahih"
          },
          "tampil": {
            "enum": [
              "nur",
              "pakaian",
              "siluet",
              "kabut_tanpa_wujud",
              "dajjal_b",
              "hewan"
            ]
          },
          "alasan_siluet": {
            "type": "string",
            "description": "wajib bila tampil=siluet: misteri | kilas_balik | kerumunan_sangat_jauh | wajah_disembunyikan"
          }
        }
      }
    },
    "hook": {
      "type": "object",
      "required": [
        "dari_beat",
        "teks"
      ],
      "additionalProperties": false,
      "properties": {
        "dari_beat": {
          "type": "integer",
          "minimum": 0
        },
        "teks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 3
        }
      }
    },
    "dalil": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "jenis",
          "label",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "jenis": {
            "enum": [
              "quran",
              "hadis"
            ]
          },
          "label": {
            "type": "string",
            "description": "teks yang tampil di layar, mis. 'QS HUD 38'"
          },
          "derajat": {
            "enum": [
              "sahih",
              "hasan",
              "daif",
              "tidak_dinilai"
            ]
          },
          "status": {
            "enum": [
              "terverifikasi",
              "belum"
            ]
          },
          "rujukan": {
            "type": "string",
            "description": "URL/sumber verifikasi (Quran Foundation, sunnah.com, dataset)"
          },
          "kitab": {
            "type": "string",
            "description": "hadis: bukhari | muslim | abudawud | tirmidhi | nasai | ibnmajah"
          },
          "nomor": {
            "type": [
              "string",
              "integer"
            ],
            "description": "hadis: nomor sunnah.com, boleh berakhiran huruf (2934b)"
          },
          "surah": {
            "type": "integer",
            "minimum": 1,
            "maximum": 114
          },
          "ayat": {
            "type": [
              "string",
              "integer"
            ],
            "description": "quran: '38' atau rentang '5-9'"
          },
          "teks_ar": {
            "type": "string"
          },
          "terjemah": {
            "type": "string"
          },
          "sumber_teks": {
            "type": "string"
          },
          "diverifikasi_oleh": {
            "type": "string"
          },
          "makna": {
            "type": "string"
          },
          "label_saran": {
            "type": "string"
          },
          "alasan": {
            "type": "string"
          },
          "berbeda": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "riwayat": {
            "type": "integer"
          },
          "bukan_marfu": {
            "type": "boolean"
          },
          "kutipan_ar": {
            "type": "string",
            "description": "potongan PERSIS dari teks_ar yang tampil di kartu (wajib untuk hadis supaya sanad tidak ikut tampil)"
          },
          "kutipan_id": {
            "type": "string",
            "description": "potongan PERSIS dari terjemah yang tampil di kartu"
          }
        }
      }
    },
    "beat": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "narasi",
          "preset",
          "keadaan",
          "shot"
        ],
        "additionalProperties": false,
        "properties": {
          "narasi": {
            "type": "string"
          },
          "preset": {
            "type": "string"
          },
          "keadaan": {
            "type": "string"
          },
          "potong_di": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dalil": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "peran_tampil": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shot": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "preset"
              ]
            }
          },
          "pelaku": {
            "type": "string",
            "description": "id peran yang melakukan aksi pada visual inti di beat ini (mis. yang membangun kapal). Penjaga mengecek ia berada paling dekat dengan visual inti."
          }
        }
      }
    }
  }
}